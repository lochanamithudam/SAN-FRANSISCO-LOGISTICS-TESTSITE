# Exclude files/dirs that should NOT be in the Docker image

# Dependencies — will be installed fresh inside container
node_modules

# Environment secrets — NEVER bake credentials into an image
.env
.env.*

# Git history — unnecessary in image
.git
.gitignore

# Dev tooling
.vscode
*.md

# Large media files — served separately or via CDN
VIDEOS

# OS files
.DS_Store
Thumbs.db
